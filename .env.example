APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Only needed if `php artisan backup:run` fails with "'mysqldump' is not
# recognized" (e.g. Laragon on Windows doesn't put it on PATH) — point this
# at the `bin` folder inside your installed MySQL version.
# DB_DUMP_BINARY_PATH=
# Optional: an extra, physically separate location the nightly backup also
# writes to, on top of the one under storage/app — protects against that
# primary drive itself failing. Off by default; every machine this runs on
# is different, so set this per-install to whatever a "second place" means
# there, e.g. "D:/GoldShopBackups" on this Windows PC, "/mnt/backup-drive"
# on a Linux server, or a mounted network share. Leave unset to skip this
# entirely (nightly backup still runs, just to the one location). A
# temporarily missing/unplugged path is skipped, not a failure.
# BACKUP_SECOND_DRIVE_PATH=
# Only needed if scanning a Bank QR payment slip fails with "'tesseract' is
# not recognized" (Windows doesn't put it on PATH by default after install).
# Point this at the full path to tesseract.exe.
# TESSERACT_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
